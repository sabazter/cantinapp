# ─── .env.app — secretos de la aplicación (lo carga el contenedor `cantinapp`) ──
# DATABASE_URL, DATABASE_SYSTEM_URL, REDIS_URL y UPLOADS_DIR los inyecta docker-compose.yml.

# ─── NextAuth ────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3005"
NEXTAUTH_SECRET=""   # firma de tokens de verificación de email (HS256)

# RS256 — generar con:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Luego copiar el contenido con \n en lugar de saltos de línea reales
NEXTAUTH_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
NEXTAUTH_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# ─── Cifrado AES-256-GCM ─────────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# ─── API interna (scraping BCV, crons) ───────────────────────────────────────
INTERNAL_API_KEY=""

# ─── Proxy de confianza ──────────────────────────────────────────────────────
# "true" si la app está detrás de Cloudflare/cloudflared/nginx: se usa CF-Connecting-IP o la
# primera IP pública de X-Forwarded-For (de derecha a izquierda).
# "false" (acceso directo, sin proxy): esas cabeceras se ignoran (son falsificables) y todas las
# peticiones comparten un único cupo de rate limit.
TRUST_PROXY="true"

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM="CantinApp <noreply@tudominio.com>"

# ─── WhatsApp (Twilio) ───────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# ─── Logging (Logtail / Better Stack) — opcional ─────────────────────────────
LOGTAIL_TOKEN=""

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3005"
