# ─── Base de datos (PostgreSQL propio, servicio `postgres` del compose) ──────
# Generar cada contraseña con:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
POSTGRES_PASSWORD=""      # dueño `cantinapp`: solo migraciones
APP_DB_PASSWORD=""        # rol `cantinapp_app`: rutas API, sujeto a RLS
SYSTEM_DB_PASSWORD=""     # rol `cantinapp_system`: login, cron, auditoría (BYPASSRLS)

# Solo para correr Prisma / `next dev` desde el host (el puerto va en loopback).
# Dentro de docker compose estas URLs se inyectan solas.
DATABASE_URL="postgresql://cantinapp_app:<APP_DB_PASSWORD>@127.0.0.1:5434/cantinapp"
DATABASE_SYSTEM_URL="postgresql://cantinapp_system:<SYSTEM_DB_PASSWORD>@127.0.0.1:5434/cantinapp"
DATABASE_ADMIN_URL="postgresql://cantinapp:<POSTGRES_PASSWORD>@127.0.0.1:5434/cantinapp"

# ─── Redis (rate limiting) ───────────────────────────────────────────────────
REDIS_PASSWORD=""
REDIS_URL="redis://:<REDIS_PASSWORD>@127.0.0.1:6379"

# ─── Archivos subidos (fotos de alumnos, comprobantes) ───────────────────────
# Directorio privado, nunca servido estáticamente. En compose es un volumen.
UPLOADS_DIR="./uploads"

# ─── NextAuth ────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""   # firma de tokens de verificación de email (HS256)

# RS256 — generar con:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Luego copiar el contenido con \n en lugar de saltos de línea reales
NEXTAUTH_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
NEXTAUTH_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# ─── Cifrado AES-256-GCM ─────────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# ─── API interna (scraping BCV, crons) ───────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=""

# ─── Proxy de confianza ──────────────────────────────────────────────────────
# "true" solo si la app corre detrás de un proxy/túnel que SOBRESCRIBE x-forwarded-for.
# Si es "false", se ignoran esas cabeceras y el rate limit usa una clave común.
TRUST_PROXY="false"

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM="CantinApp <noreply@tudominio.com>"

# ─── WhatsApp (Twilio) ───────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# ─── Logging (Logtail / Better Stack) ───────────────────────────────────────
# Opcional: sin esta var los logs van solo a console
LOGTAIL_TOKEN=""

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
