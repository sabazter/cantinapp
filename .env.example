# ─── Base de datos (Supabase PostgreSQL) ────────────────────────────────────
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# ─── NextAuth ────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""   # solo para compatibilidad, la firma real usa RS256 abajo

# RS256 — generar con:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Luego copiar el contenido con \n en lugar de saltos de línea reales
NEXTAUTH_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
NEXTAUTH_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# ─── Cifrado AES-256-GCM ─────────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# ─── API interna (scraping BCV, crons) ───────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=""

# ─── Rate limiting (Upstash Redis) ───────────────────────────────────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM="CantinApp <noreply@tudominio.com>"

# ─── WhatsApp (Twilio) ───────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# ─── Logging (Logtail / Better Stack) ───────────────────────────────────────
# Obtener en: https://betterstack.com/logtail → New Source → Node.js
# Opcional: sin esta var los logs van solo a console
LOGTAIL_TOKEN=""

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
