generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Multi-tenant root
// ─────────────────────────────────────────────

model Cantina {
  id               String    @id @default(cuid())
  nombre           String
  escuela          String
  direccion        String?
  tasaManual       Decimal?  @map("tasa_manual") @db.Decimal(12, 4)
  limiteFiadoUsd   Decimal?  @map("limite_fiado_usd") @db.Decimal(10, 2)
  umbralDeudaUsd   Decimal   @default(20) @map("umbral_deuda_usd") @db.Decimal(10, 2)
  notifEmail       Boolean   @default(true) @map("notif_email")
  notifWhatsapp    Boolean   @default(true) @map("notif_whatsapp")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  usuarios         Usuario[]
  alumnos          Alumno[]
  productos        Producto[]
  ventas           Venta[]
  tasasBcv         TasaBcv[]

  @@map("cantinas")
}

// ─────────────────────────────────────────────
// Usuarios del sistema
// ─────────────────────────────────────────────

enum Rol {
  admin
  vendedor
  representante
  directivo
  superadmin
  profesor
  alumno
}

model Usuario {
  id               String         @id @default(cuid())
  cantinaId        String?        @map("cantina_id")
  nombre           String
  email            String         @unique
  hashPwd          String         @map("hash_pwd")
  rol              Rol
  telefono         String?
  activo           Boolean        @default(true)
  mfaSecret        String?        @map("mfa_secret")
  mfaHabilitado    Boolean        @default(false) @map("mfa_habilitado")
  emailVerificado  Boolean        @default(false) @map("email_verificado")
  notifEmail       Boolean        @default(true)  @map("notif_email")
  notifWhatsapp    Boolean        @default(true)  @map("notif_whatsapp")
  notasCrm         String?        @map("notas_crm")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  cantina          Cantina?       @relation(fields: [cantinaId], references: [id])
  alumnos          Alumno[]       @relation("RepresentanteAlumnos")
  perfilAlumno     Alumno?        @relation("UsuarioAlumno")
  ventasRealizadas Venta[]        @relation("VendedorVentas")
  abonosConfirmados Abono[]       @relation("AdminAbonos")
  notificaciones   Notificacion[]
  refreshTokens    RefreshToken[]
  auditLogs        AuditLog[]

  @@map("usuarios")
}

// ─────────────────────────────────────────────
// Seguridad — Auth
// ─────────────────────────────────────────────

model RefreshToken {
  id          String    @id @default(cuid())
  usuarioId   String    @map("usuario_id")
  tokenHash   String    @unique @map("token_hash")
  userAgent   String?   @map("user_agent")
  ip          String?
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  usuario     Usuario   @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@map("refresh_tokens")
}

model LoginIntento {
  id          String    @id @default(cuid())
  email       String
  ip          String
  exitoso     Boolean
  bloqueado   Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@map("login_intentos")
}

// ─────────────────────────────────────────────
// Auditoría (inmutable)
// ─────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  usuarioId  String?  @map("usuario_id")
  cantinaId  String?  @map("cantina_id")
  evento     String
  entidad    String?
  entidadId  String?  @map("entidad_id")
  datos      Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  usuario    Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([cantinaId, createdAt])
  @@index([usuarioId, createdAt])
  @@index([evento, createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// Alumnos y cuentas
// ─────────────────────────────────────────────

model Alumno {
  id                  String    @id @default(cuid())
  cantinaId           String    @map("cantina_id")
  representanteId     String?   @map("representante_id")
  usuarioId           String?   @unique @map("usuario_id")
  nombre              String
  cedulaEncriptada    String    @map("cedula_encriptada")
  curso               String
  seccion             String?
  fotoUrl             String?   @map("foto_url")
  qrCode              String?   @map("qr_code")
  fiadoHabilitado     Boolean   @default(false) @map("fiado_habilitado")
  limiteFiadoUsd      Decimal?  @map("limite_fiado_usd") @db.Decimal(10, 2)
  consentimientoIp    String?   @map("consentimiento_ip")
  consentimientoAt    DateTime? @map("consentimiento_at")
  activo              Boolean   @default(true)
  deletedAt           DateTime? @map("deleted_at")
  deletedBy           String?   @map("deleted_by")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  cantina          Cantina   @relation(fields: [cantinaId], references: [id])
  representante    Usuario?  @relation("RepresentanteAlumnos", fields: [representanteId], references: [id])
  usuario          Usuario?  @relation("UsuarioAlumno", fields: [usuarioId], references: [id])
  cuenta           CuentaAlumno?
  ventas           Venta[]

  @@index([cantinaId])
  @@map("alumnos")
}

model CuentaAlumno {
  id        String    @id @default(cuid())
  alumnoId  String    @unique @map("alumno_id")
  saldo     Decimal   @default(0) @db.Decimal(10, 2)
  updatedAt DateTime  @updatedAt @map("updated_at")

  alumno    Alumno    @relation(fields: [alumnoId], references: [id])
  abonos    Abono[]

  @@map("cuentas_alumnos")
}

// ─────────────────────────────────────────────
// Inventario
// ─────────────────────────────────────────────

enum CategoriaProducto {
  tienda
  menu
}

model Producto {
  id          String             @id @default(cuid())
  cantinaId   String             @map("cantina_id")
  nombre      String
  categoria   CategoriaProducto  @default(tienda)
  precioUsd   Decimal            @map("precio_usd") @db.Decimal(10, 4)
  stock       Int                @default(0)
  stockMin    Int                @default(5) @map("stock_min")
  activo      Boolean            @default(true)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  cantina     Cantina            @relation(fields: [cantinaId], references: [id])
  detalles    DetalleVenta[]
  movimientos MovimientoInventario[]

  @@map("productos")
}

enum TipoMovimiento {
  entrada
  venta
  ajuste
}

model MovimientoInventario {
  id          String          @id @default(cuid())
  productoId  String          @map("producto_id")
  tipo        TipoMovimiento
  cantidad    Int
  motivo      String?
  usuarioId   String?         @map("usuario_id")
  deletedAt   DateTime?       @map("deleted_at")
  deletedBy   String?         @map("deleted_by")
  createdAt   DateTime        @default(now()) @map("created_at")

  producto    Producto        @relation(fields: [productoId], references: [id])

  @@map("movimientos_inventario")
}

// ─────────────────────────────────────────────
// Tasa BCV
// ─────────────────────────────────────────────

enum FuenteTasa {
  automatica
  manual
}

model TasaBcv {
  id         String      @id @default(cuid())
  cantinaId  String      @map("cantina_id")
  fecha      DateTime    @db.Date
  tasaUsdBs  Decimal     @map("tasa_usd_bs") @db.Decimal(12, 4)
  fuente     FuenteTasa  @default(automatica)
  createdAt  DateTime    @default(now()) @map("created_at")

  cantina    Cantina     @relation(fields: [cantinaId], references: [id])

  @@unique([cantinaId, fecha])
  @@map("tasas_bcv")
}

// ─────────────────────────────────────────────
// Ventas
// ─────────────────────────────────────────────

enum MetodoPago {
  efectivo_usd
  efectivo_bs
  pago_movil
  fiado
}

model Venta {
  id           String      @id @default(cuid())
  cantinaId    String      @map("cantina_id")
  vendedorId   String      @map("vendedor_id")
  alumnoId     String?     @map("alumno_id")
  tasaBcv      Decimal     @map("tasa_bcv") @db.Decimal(12, 4)
  totalUsd     Decimal     @map("total_usd") @db.Decimal(10, 4)
  totalBs      Decimal     @map("total_bs") @db.Decimal(14, 4)
  metodoPago   MetodoPago  @map("metodo_pago")
  esFiado      Boolean     @default(false) @map("es_fiado")
  referencia   String?
  deletedAt    DateTime?   @map("deleted_at")
  deletedBy    String?     @map("deleted_by")
  deletedMotivo String?    @map("deleted_motivo")
  createdAt    DateTime    @default(now()) @map("created_at")

  cantina      Cantina     @relation(fields: [cantinaId], references: [id])
  vendedor     Usuario     @relation("VendedorVentas", fields: [vendedorId], references: [id])
  alumno       Alumno?     @relation(fields: [alumnoId], references: [id])
  detalles     DetalleVenta[]

  @@index([cantinaId, createdAt])
  @@map("ventas")
}

model DetalleVenta {
  id                String   @id @default(cuid())
  ventaId           String   @map("venta_id")
  productoId        String   @map("producto_id")
  cantidad          Int
  precioUsdUnitario Decimal  @map("precio_usd_unitario") @db.Decimal(10, 4)

  venta             Venta    @relation(fields: [ventaId], references: [id])
  producto          Producto @relation(fields: [productoId], references: [id])

  @@map("detalle_ventas")
}

// ─────────────────────────────────────────────
// Abonos y pagos
// ─────────────────────────────────────────────

enum MetodoAbono {
  efectivo_usd
  efectivo_bs
  pago_movil
  transferencia
}

enum EstadoAbono {
  pendiente
  confirmado
  rechazado
}

model Abono {
  id                  String      @id @default(cuid())
  cuentaAlumnoId      String      @map("cuenta_alumno_id")
  montoUsd            Decimal     @map("monto_usd") @db.Decimal(10, 4)
  montoBs             Decimal?    @map("monto_bs") @db.Decimal(14, 4)
  tasaBcv             Decimal?    @map("tasa_bcv") @db.Decimal(12, 4)
  metodo              MetodoAbono
  referenciaEncriptada String?    @map("referencia_encriptada")
  banco               String?
  comprobanteUrl      String?     @map("comprobante_url")
  estado              EstadoAbono @default(pendiente)
  confirmadoPor       String?     @map("confirmado_por")
  confirmadoAt        DateTime?   @map("confirmado_at")
  motivoRechazo       String?     @map("motivo_rechazo")
  deletedAt           DateTime?   @map("deleted_at")
  deletedBy           String?     @map("deleted_by")
  createdAt           DateTime    @default(now()) @map("created_at")

  cuentaAlumno    CuentaAlumno @relation(fields: [cuentaAlumnoId], references: [id])
  admin           Usuario?     @relation("AdminAbonos", fields: [confirmadoPor], references: [id])

  @@map("abonos")
}

// ─────────────────────────────────────────────
// Notificaciones
// ─────────────────────────────────────────────

enum TipoNotificacion {
  fiado_registrado
  abono_confirmado
  deuda_alta
  stock_bajo
  resumen_diario
  abono_pendiente
}

enum CanalNotificacion {
  email
  whatsapp
}

enum EstadoNotificacion {
  pendiente
  enviado
  error
}

model Notificacion {
  id         String              @id @default(cuid())
  usuarioId  String              @map("usuario_id")
  tipo       TipoNotificacion
  canal      CanalNotificacion
  estado     EstadoNotificacion  @default(pendiente)
  enviadoAt  DateTime?           @map("enviado_at")
  createdAt  DateTime            @default(now()) @map("created_at")

  usuario    Usuario             @relation(fields: [usuarioId], references: [id])

  @@map("notificaciones")
}
